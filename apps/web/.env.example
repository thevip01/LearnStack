# Browser-side base URL for the API. Must be reachable from the user's machine.
# The client appends /api/v1 when the value does not already end with it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side base URL used by React Server Components inside the compose network.
API_INTERNAL_URL=http://api:8000

# Next.js runtime
PORT=3000
NEXT_TELEMETRY_DISABLED=1
