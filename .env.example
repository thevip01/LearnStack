# Copy to .env only if you want to override something. The stack boots without it.
#
# Anything marked UNSAFE is fine on a laptop and must be changed before this is
# reachable by anyone else.

ENV=development
LOG_LEVEL=INFO

# --- ports on your host -----------------------------------------------------
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- auth -------------------------------------------------------------------
# UNSAFE default. The API refuses to start with this value when ENV is not a
# development-like value.
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_EXPIRES_MINUTES=10080

# --- sandbox ----------------------------------------------------------------
# auto      : use Docker when the socket is reachable, else fall back
# docker    : require Docker, fail loudly if unavailable
# subprocess: rlimit-based local execution. Weaker isolation, development only.
SANDBOX_MODE=auto
# "none" means sandbox containers get no network at all. Any other value is a
# Docker network name, used only by tasks that explicitly opt in.
SANDBOX_NETWORK=none
EXECUTION_MAX_CONCURRENCY=4
EXECUTION_OUTPUT_LIMIT_BYTES=64000

# --- bootstrap --------------------------------------------------------------
# create_all on startup. Fine until the first migration exists; see
# apps/api/alembic/README for the handover.
AUTO_CREATE_SCHEMA=true
# UNSAFE: creates an account with a known password.
SEED_DEMO_USER=true
DEMO_USER_EMAIL=demo@learnos.dev
DEMO_USER_PASSWORD=learnos-demo-2026

# --- web --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
